*.pth
*.onnx
*.ckpt
*.npz
*.npy

# --- 一時ファイル ---
*.log
*.out
*.tmp
*.cache
tmp/
**/.pytest_cache/
.coverage
*.coverage
htmlcov/

# --- Docker 関連（機密が入りやすい）---
docker/.env
docker-compose.override.yml

# --- その他（画像生成物・図表など任意）---
reports/
figures/
